{
  "manifest_version": 3,
  "name": "tyne.pro",
  "short_name": "tyne.pro",
  "version": "2.2.0",
  "description": "Інструменти кабінету tyne.pro у вашому браузері: розіграш у коментарях Instagram, аудит бізнесу та база компаній з Google Карт. Дані читаються з вашої сесії і йдуть лише у ваш кабінет.",
  "permissions": [
    "cookies",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://i.instagram.com/*",
    "https://www.google.com/*",
    "https://cp.tyne.pro/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://cp.tyne.pro/*"
      ],
      "js": [
        "cabinet.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "tyne.pro",
    "default_popup": "menu.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "homepage_url": "https://cp.tyne.pro/",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
